<% @page_title = "Client dashboard" %>
<%= render "settings/header", current: :client_dashboard %>
<%# The client dashboard's settings (ClientDashboard::SettingsController): the cards a client sees
    on arriving in the portal and their order (CardMovesController), the line under the greeting,
    and how far the cards look. %>
<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Cards</h2>
      <p class="settings-section__description">What a <%= term(:client).downcase %> sees first in the portal, above their <%= term(:work, count: 2).downcase %>, top to bottom in this order. A card shows only when it holds something. To see it as one of them does, open a contact and choose View as.</p>
    </header>
    <ul class="settings-list client-dashboard-cards">
      <% @setting.ordered_cards.each_with_index do |key, index| %>
        <%# herb:key key %>
        <li class="list-row">
          <div class="list-row__content">
            <p class="list-row__title"><%= ClientDashboard::Setting::CARDS[key].first %><% unless @setting.shown?(key) %> <%= badge "Off", tone: :neutral %><% end %></p>
            <p class="list-row__desc"><%= ClientDashboard::Setting::CARDS[key].last %></p>
          </div>
          <div class="list-row__actions">
            <%= button_to client_dashboard_card_moves_path(card: key, direction: "up"), class: "icon-button", title: "Move up", disabled: index.zero? do %>
              <%= icon_tag "arrow-up" %><span class="visually-hidden">Move <%= ClientDashboard::Setting::CARDS[key].first %> up</span>
            <% end %>
            <%= button_to client_dashboard_card_moves_path(card: key, direction: "down"), class: "icon-button client-dashboard-cards__down", title: "Move down", disabled: index == @setting.ordered_cards.size - 1 do %>
              <%= icon_tag "arrow-up" %><span class="visually-hidden">Move <%= ClientDashboard::Setting::CARDS[key].first %> down</span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <%= form_with model: @setting, url: client_dashboard_settings_path, method: :patch, scope: :setting, class: "settings-form" do |form| %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h2>What shows</h2>
        <p class="settings-section__description">Switch off a card your <%= term(:client, count: 2).downcase %> don’t need.</p>
      </header>
      <% if @setting.errors.any? %>
        <div class="alert alert--danger" role="alert"><%= @setting.errors.full_messages.to_sentence %>.</div>
      <% end %>
      <%= hidden_field_tag "setting[shown][]", "", id: nil %>
      <div class="client-dashboard-settings__cards">
        <% @setting.ordered_cards.each do |key| %>
          <%# herb:key key %>
          <label class="checkbox">
            <%= check_box_tag "setting[shown][]", key, @setting.shown?(key), id: "setting_shown_#{key}" %>
            <span><%= ClientDashboard::Setting::CARDS[key].first %></span>
          </label>
        <% end %>
      </div>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Greeting</h2>
        <p class="settings-section__description">The dashboard opens with “Hello,” and the person’s first name. This is the line under it.</p>
      </header>
      <label class="field">
        <span class="field__label">The line under the greeting</span>
        <%= form.text_field :greeting, placeholder: ClientDashboard::Setting::DEFAULT_GREETING, maxlength: 200, autocomplete: "off" %>
      </label>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>How far the cards look</h2>
      </header>
      <div class="field-row">
        <label class="field">
          <span class="field__label">Coming up: days ahead</span>
          <%= form.number_field :due_days, min: 1, max: 90 %>
        </label>
        <label class="field">
          <span class="field__label">New documents and Recently done: days back</span>
          <%= form.number_field :recent_days, min: 1, max: 365 %>
        </label>
      </div>
      <div class="button-row"><button type="submit" class="btn btn--primary">Save</button></div>
    </section>
  <% end %>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Who hears about what</h2>
      <p class="settings-section__description">That’s set per <%= term(:client).downcase %>: open one and choose its Client dashboard tab. There, each of their people and each of your team is set to always, as usual or never, for each kind of notice.</p>
    </header>
  </section>
</div>
