<% @page_title = "Client dashboard" %>
<%= render "settings/header", current: :client_dashboard %>
<%# The client dashboard's settings (ClientDashboard::SettingsController): the cards a client sees
    on arriving in the portal and their order (CardMovesController), the line under the greeting,
    and how far the cards look. %>
<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Cards</h2>
      <p class="settings-section__description">What a <%= term(:client).downcase %> sees first in the portal, above their <%= term(:work, count: 2).downcase %>, top to bottom in this order. A card shows only when it holds something. To see it as one of them does, open a contact and choose View as.</p>
    </header>
    <ul class="settings-list client-dashboard-cards">
      <% @setting.ordered_cards.each_with_index do |key, index| %>
        <%# herb:key key %>
        <li class="settings-item">
          <div class="settings-item__content">
            <p class="settings-item__title"><%= ClientDashboard::Setting::CARDS[key].first %><% unless @setting.shown?(key) %> <%= ui :badge, variant: :secondary, content: "Off" %><% end %></p>
            <p class="settings-item__desc"><%= ClientDashboard::Setting::CARDS[key].last %></p>
          </div>
          <div class="settings-item__actions client-dashboard-cards__actions">
            <%= button_to client_dashboard_card_moves_path(card: key, direction: "up"), class: "ui-button", data: { variant: "ghost", size: "icon-sm" }, title: "Move up", disabled: index.zero? do %>
              <%= icon_tag "arrow-up" %><span class="ui-sr-only">Move <%= ClientDashboard::Setting::CARDS[key].first %> up</span>
            <% end %>
            <%= button_to client_dashboard_card_moves_path(card: key, direction: "down"), class: "ui-button", data: { variant: "ghost", size: "icon-sm" }, title: "Move down", disabled: index == @setting.ordered_cards.size - 1 do %>
              <%= icon_tag "arrow-up", class: "client-dashboard-cards__down" %><span class="ui-sr-only">Move <%= ClientDashboard::Setting::CARDS[key].first %> down</span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <%= form_with model: @setting, url: client_dashboard_settings_path, method: :patch, scope: :setting, class: "settings-form client-dashboard-settings__form" do |form| %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h2>What shows</h2>
        <p class="settings-section__description">Switch off a card your <%= term(:client, count: 2).downcase %> don’t need.</p>
      </header>
      <% if @setting.errors.any? %>
        <%= ui :alert, variant: :destructive, title: "Couldn’t save", description: "#{@setting.errors.full_messages.to_sentence}." %>
      <% end %>
      <%= hidden_field_tag "setting[shown][]", "", id: nil %>
      <div class="client-dashboard-settings__cards">
        <% @setting.ordered_cards.each do |key| %>
          <%# herb:key key %>
          <%= ui :checkbox, name: "setting[shown][]", value: key, checked: @setting.shown?(key), id: "setting_shown_#{key}", label: ClientDashboard::Setting::CARDS[key].first %>
        <% end %>
      </div>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Greeting</h2>
        <p class="settings-section__description">The dashboard opens with “Hello,” and the person’s first name. This is the line under it.</p>
      </header>
      <%= form.ui :field, :greeting, label: "The line under the greeting" do %>
        <%= form.text_field :greeting, placeholder: ClientDashboard::Setting::DEFAULT_GREETING, maxlength: 200, autocomplete: "off" %>
      <% end %>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>How far the cards look</h2>
      </header>
      <div class="client-dashboard-settings__row">
        <%= form.ui :field, :due_days, label: "Coming up: days ahead" do %>
          <%= form.number_field :due_days, min: 1, max: 90 %>
        <% end %>
        <%= form.ui :field, :recent_days, label: "New documents and Recently done: days back" do %>
          <%= form.number_field :recent_days, min: 1, max: 365 %>
        <% end %>
      </div>
      <div><%= ui :button, type: :submit, content: "Save" %></div>
    </section>
  <% end %>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Who hears about what</h2>
      <p class="settings-section__description">That’s set per <%= term(:client).downcase %>: open one and choose its Client dashboard tab. There, each of their people and each of your team is set to always, as usual or never, for each kind of notice.</p>
    </header>
  </section>
</div>
